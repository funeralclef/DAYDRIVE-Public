      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Button.sidePetal:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- One colour for all three. The settings petal used to be given the lighter, more
         transparent alt surface, which read on screen as one of the three tabs being a
         different material from its neighbours. -->
