    <Style Selector="PopupRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TransparencyBackgroundFallback" Value="Transparent" />
      <Setter Property="TransparencyLevelHint" Value="Transparent,AcrylicBlur,Blur" />
    </Style>
    <!-- A menu flyout is a list like any other in the shell, and it used to be the one list
         that ignored the theme: the presenter is not a FlyoutPresenter, so the rule above never
         reached it and Fluent's own plate showed through under the event actions. -->
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="FlyoutPresenter /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>

    <Style Selector="Border.floatingModelCard">
      <Setter Property="Background" Value="{DynamicResource ShellChatField}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow3}" />
    </Style>

    <Style Selector="Border.resourceMonitorPill">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- One figure in the monitor: what it is, how much of it, and how much of it that is.
         All four columns are built the same way, so the eye compares them rather than reading
         them. The type is set on its own line heights rather than the theme's: three lines at
         the default leading is most of the card's height spent on air. -->
    <Style Selector="StackPanel.resourceReadout">
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="TextBlock.resourceName">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont8_5}" />
      <Setter Property="LineHeight" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="TextBlock.resourceValue">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="LineHeight" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- A figure that is not a measurement — "not in use" — is not read as one either. -->
    <Style Selector="TextBlock.resourceValue.idle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="ProgressBar.resourceMeter">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Height" Value="3" />
      <Setter Property="MinHeight" Value="3" />
      <!-- The theme gives a progress bar a minimum width wider than the column it is in here,
           so without this the three meters are each measured at that width, overrun their
           columns and overlap each other into one broken line across the card. -->
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The bar moves once a second on a timer. Without this it steps; with it, it travels. -->
    <Style Selector="Window.motion ProgressBar.resourceMeter /template/ Border#PART_Indicator">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.45" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- A meter for something that is not running is a groove with nothing in it. -->
    <Style Selector="ProgressBar.resourceMeter:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.modelOptionCard">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
