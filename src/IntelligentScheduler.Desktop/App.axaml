<Application xmlns="https://github.com/avaloniaui"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IntelligentScheduler.Desktop"
             xmlns:icons="using:IntelligentScheduler.Desktop.Controls"
             x:Class="IntelligentScheduler.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Nonzero alpha also keeps transparent input bridges clickable on native layered windows. -->
    <SolidColorBrush x:Key="ShellInputSurface" Color="#01000000" />
    <!-- lucide-animated vectors are used for semantic motion icons; Phosphor 2.1.2 remains the fallback. -->
    <icons:CompactScrollViewportConverter x:Key="CompactScrollViewportConverter" />
    <x:String x:Key="IconCog">&#xE272;</x:String>
    <x:String x:Key="IconChevronRight">&#xE13A;</x:String>
    <x:String x:Key="IconChevronLeft">&#xE138;</x:String>
    <x:String x:Key="IconChevronDown">&#xE136;</x:String>
    <x:String x:Key="IconChevronUp">&#xE13C;</x:String>
    <x:String x:Key="IconPlus">&#xE3D4;</x:String>
    <x:String x:Key="IconCalendar">&#xE7B4;</x:String>
    <x:String x:Key="IconCheck">&#xE182;</x:String>
    <x:String x:Key="IconEdit">&#xE3B4;</x:String>
    <x:String x:Key="IconMenu">&#xE1FE;</x:String>
    <x:String x:Key="IconCopy">&#xE1CA;</x:String>
    <x:String x:Key="IconDelete">&#xE4A6;</x:String>
    <x:String x:Key="IconSparkle">&#xE6A2;</x:String>
    <x:String x:Key="IconClose">&#xE4F6;</x:String>
    <x:String x:Key="IconTune">&#xE434;</x:String>
    <x:String x:Key="IconSend">&#xE398;</x:String>
    <x:String x:Key="IconAttach">&#xE39A;</x:String>
    <x:String x:Key="IconArrowUp">&#xE08E;</x:String>
    <x:String x:Key="IconClock">&#xE19A;</x:String>
    <x:String x:Key="IconChat">&#xE168;</x:String>
    <x:String x:Key="IconPlay">&#xE3D0;</x:String>
    <x:String x:Key="IconStop">&#xE46C;</x:String>
    <x:String x:Key="IconPower">&#xE3DA;</x:String>
    <x:String x:Key="IconHistory">&#xE1A0;</x:String>
    <x:String x:Key="IconMemory">&#xE74E;</x:String>
    <x:String x:Key="IconCompose">&#xE34C;</x:String>
    <x:String x:Key="IconSearch">&#xE30C;</x:String>
    <x:String x:Key="IconPin">&#xE3E2;</x:String>
    <x:String x:Key="IconRefresh">&#xE094;</x:String>
    <x:String x:Key="IconTool">&#xE5D4;</x:String>
    <x:String x:Key="IconChart">&#xE150;</x:String>
    <x:String x:Key="IconFlame">&#xE242;</x:String>
    <x:String x:Key="IconTimer">&#xE492;</x:String>
    <x:String x:Key="IconSkip">&#xE5A6;</x:String>
    <SolidColorBrush x:Key="ShellBackground" Color="#E213110F" />
    <SolidColorBrush x:Key="ShellSurface" Color="#D2131720" />
    <SolidColorBrush x:Key="ShellSurfaceAlt" Color="#BE1A1F2B" />
    <SolidColorBrush x:Key="ShellPopup" Color="#FF131720" />
    <SolidColorBrush x:Key="ShellPopupBlur" Color="#E6131720" />
    <SolidColorBrush x:Key="ShellChatPanel" Color="#F5131720" />
    <SolidColorBrush x:Key="ShellChatField" Color="#E81A1F2B" />
    <Color x:Key="ShellTint">#131720</Color>
    <Color x:Key="ShellTintBackground">#13110F</Color>
    <SolidColorBrush x:Key="ShellText" Color="#F4F6FB" />
    <SolidColorBrush x:Key="ShellMuted" Color="#929BAD" />
    <SolidColorBrush x:Key="ShellIconPrimary" Color="#F4F6FB" />
    <SolidColorBrush x:Key="ShellIconMuted" Color="#A5ADBC" />
    <SolidColorBrush x:Key="ShellIconOnAccent" Color="#17121E" />
    <SolidColorBrush x:Key="ShellOnAccent" Color="#17121E" />
    <SolidColorBrush x:Key="ShellSecondary" Color="#D9967F" />
    <SolidColorBrush x:Key="ShellTertiary" Color="#93A88E" />
    <SolidColorBrush x:Key="ShellSuccess" Color="#55D6A1" />
    <SolidColorBrush x:Key="ShellSuccessSoft" Color="#3855D6A1" />
    <SolidColorBrush x:Key="ShellWarning" Color="#F4B860" />
    <!-- Placeholders only. ShellThemeService replaces every one of these on startup with the
         evenly spaced ladder CategoryPalette builds; these are the values that ladder produces
         for the default palette on a dark shell, so a designer opening this file sees the same
         colours the application runs with. -->
    <SolidColorBrush x:Key="ShellCategoryGeneral" Color="#BDA7FF" />
    <SolidColorBrush x:Key="ShellCategoryWork" Color="#A2CAFF" />
    <SolidColorBrush x:Key="ShellCategoryPersonal" Color="#E081CD" />
    <SolidColorBrush x:Key="ShellCategoryStudy" Color="#00D5B2" />
    <SolidColorBrush x:Key="ShellCategoryHealth" Color="#9CDD76" />
    <SolidColorBrush x:Key="ShellCategorySocial" Color="#FFAEB3" />
    <SolidColorBrush x:Key="ShellCategoryErrands" Color="#FF9B51" />
    <SolidColorBrush x:Key="ShellCategoryTravel" Color="#C5A500" />
    <SolidColorBrush x:Key="ShellCategoryRest" Color="#00BBDA" />
    <SolidColorBrush x:Key="ShellFocus" Color="#FFB45E" />
    <SolidColorBrush x:Key="ShellAccent" Color="#9B8CFF" />
    <SolidColorBrush x:Key="ShellAccentHover" Color="#ABA0FF" />
    <SolidColorBrush x:Key="ShellAccentGlow" Color="#B8AEFF" />
    <SolidColorBrush x:Key="ShellAccentDeep" Color="#8473F5" />
    <SolidColorBrush x:Key="ShellAccentTransparent" Color="#009B8CFF" />
    <SolidColorBrush x:Key="ShellAccentSoft" Color="#3D9B8CFF" />
    <SolidColorBrush x:Key="ShellStroke" Color="#AF2B3241" />
    <SolidColorBrush x:Key="ShellStrokeTransparent" Color="#002B3241" />
    <SolidColorBrush x:Key="ShellSurfaceAltTransparent" Color="#001A1F2B" />
    <SolidColorBrush x:Key="ShellDanger" Color="#FF8295" />
    <SolidColorBrush x:Key="ShellDangerHover" Color="#FF93A4" />
    <SolidColorBrush x:Key="ShellDangerGlow" Color="#FFA5B5" />
    <SolidColorBrush x:Key="ShellDangerDeep" Color="#E56B80" />
    <SolidColorBrush x:Key="ShellDangerTransparent" Color="#00FF8295" />
    <LinearGradientBrush x:Key="ShellAccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#C2B6FF" />
      <GradientStop Offset="0.55" Color="#9B8CFF" />
      <GradientStop Offset="1" Color="#B8AAFF" />
    </LinearGradientBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector=":is(Control)">
      <Setter Property="ToolTip.ShowDelay" Value="850" />
      <!-- Always wait, even when the pointer has just left another hint. -->
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="MaxWidth" Value="300" />
      <Setter Property="FontFamily" Value="{DynamicResource ShellFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" BoxShadow="{DynamicResource MarelianShadow10}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToolTip TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="276" />
    </Style>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource ShellFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont12}" />
      <Setter Property="Background" Value="Transparent" />
      <!-- Avalonia's default fallback is solid white. macOS can briefly negotiate a lower
           transparency level while a borderless window is opening, which exposed that fallback
           as a rectangular plate behind every rounded shell surface. -->
      <Setter Property="TransparencyBackgroundFallback" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellIconPrimary}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <!-- Text that can be taken. A type selector in Avalonia matches its own type and not what
         derives from it, so the block above never reaches these and they carry their own
         colour. The selection is the accent at the weight the rest of the shell selects with. -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont21}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.25" />
    </Style>
    <Style Selector="TextBlock.headerClock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont17}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="LetterSpacing" Value="0.3" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont15}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
    </Style>

    <!-- Phosphor icon motion and smooth color transitions -->
    <Style Selector="icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellIconPrimary}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="icons|AnimatedIcon.muted">
      <Setter Property="Foreground" Value="{DynamicResource ShellIconMuted}" />
    </Style>
    <Style Selector="icons|AnimatedIcon.onAccent">
      <Setter Property="Foreground" Value="{DynamicResource ShellIconOnAccent}" />
    </Style>
    <Style Selector="Window.motion Button:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="scale(1.13) rotate(-4deg)" />
    </Style>
    <Style Selector="Window.motion Button:pointerover icons|AnimatedIcon.completeSpin">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="icons|AnimatedIcon.expandChevron">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="icons|AnimatedIcon.expandChevron.expanded">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- Surface containers & cards -->
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.surfaceAlt">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
    </Style>

    <!-- The sync card's dot: one colour per state, so where the data stands reads before the
         sentence beside it does. The base rule comes first — a later rule wins, whatever it is. -->
    <Style Selector="Border.syncDot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.syncDot.small">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.syncDot.ok"><Setter Property="Background" Value="{DynamicResource ShellSuccess}" /></Style>
    <Style Selector="Border.syncDot.pending"><Setter Property="Background" Value="{DynamicResource ShellWarning}" /></Style>
    <Style Selector="Border.syncDot.attention"><Setter Property="Background" Value="{DynamicResource ShellWarning}" /></Style>
    <Style Selector="Border.syncDot.busy"><Setter Property="Background" Value="{DynamicResource ShellAccent}" /></Style>
    <Style Selector="Border.syncDot.error"><Setter Property="Background" Value="{DynamicResource ShellDanger}" /></Style>
    <Style Selector="Border.interactive">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.interactive:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.emphasis">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
        <!-- The settings panel's own vocabulary. Cards were opening with a title, a title and a
         rule, or a title and a sentence depending on which one you were looking at, and the
         rules inside them were Separator in some cards and a Border in others. There is one
         of each now, and a card that wants either says which. -->
    <Style Selector="StackPanel.cardHeading">
      <Setter Property="Spacing" Value="3" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.cardRule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
    </Style>
    <!-- Tick boxes that belong together sit closer to each other than to anything else. -->
    <Style Selector="StackPanel.checkList">
      <Setter Property="Spacing" Value="7" />
    </Style>

    <Style Selector="Border.settingCard">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.themePreview">
      <Setter Property="Background" Value="{DynamicResource ShellBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="11" />
    </Style>
    <Style Selector="Border.themeModeSelector">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.themeModeChoice">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>
    <Style Selector="Button.themeModeChoice.active">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.themeModeChoice:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.colorCustomization">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <!-- The same shape as the colour callout above it, without the accent border: this group is
         a setting, not something the interface is asking to be noticed. -->
    <Style Selector="Border.settingGroup">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.themeColorButton">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Height" Value="50" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.themeColorButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.themeColorButton.active">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.themeColorEditor">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.colorHex">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.themeColorSpectrumFrame">
      <Setter Property="Background" Value="{DynamicResource ShellBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBox.colorHexInput">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.colorHexInput.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Expander.appearanceDetails">
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="6">
            <ToggleButton Name="PART_toggle" Classes="appearanceExpanderHeader"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
                <icons:AnimatedIcon Grid.Column="1" Data="{StaticResource IconChevronDown}" Width="11" Height="11" VerticalAlignment="Center" />
              </Grid>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}" Margin="0,2" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.appearanceExpanderHeader">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.appearanceExpanderHeader:pointerover, ToggleButton.appearanceExpanderHeader:checked">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="ToggleButton.appearanceExpanderHeader:checked icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Border.aiConnectionCard">
      <Setter Property="Padding" Value="11" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.aiConnectionCard.api">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.aiConnectionCard.mcp">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.aiConnectionIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16,16,10,16" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.aiConnectionIcon icons|AnimatedIcon">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.modelCard">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.modelCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.modelCard:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- Stretch rather than a fixed width: a hard 360 px overflowed every narrow container
         and was the cause of controls overlapping each other in the settings page. -->
    <Style Selector="StackPanel.settingsPanel TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel.settingsPanel ComboBox">
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel.settingsPanel Slider">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Border.formCard">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
    </Style>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.copilotComposer">
      <Setter Property="Background" Value="{DynamicResource ShellChatField}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.copilotComposer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- The sheet unfolds out of the petal that opens it. It used to rise off the bottom edge,
         which was where the pill that opened it stood; the petals are on the other side of the
         card and level with the middle of it, so the movement now comes from there — held to
         the left edge, level with the second petal, growing out along its own width.

         Two clocks on purpose. The light arrives first, so the conversation is readable almost
         at once; the shape takes a little longer to finish, which is what keeps a movement this
         small from reading as a jump. Leaving is the same picture played backwards: the sheet
         is kept on the screen for the length of this transition after it has been closed, so
         that it has frames to leave on rather than simply ceasing to be there. -->
    <Style Selector="local|ChatFlyoutView.chatFlyout">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="0%,31%" />
      <Setter Property="RenderTransform" Value="translateX(-14px) scaleX(0.965) scaleY(0.985)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.17" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="local|ChatFlyoutView.chatFlyout.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateX(0px) scaleX(1) scaleY(1)" />
    </Style>

    <!-- The planner is left alone while the conversation sits over it. Blurring it was a
         full-surface effect pass on every change underneath — sixty of them a second, for a
         layer the sheet already covers — and on screen it read as the whole window losing
         focus the moment the assistant was opened. What is kept is the quiet: the window takes
         a .glass class while the sheet is up and the three ambient loops that live in this
         card — the pill's bloom, the current event's glow and the tracking pulse — stop for as
         long as it is there, because nothing behind the sheet is worth repainting. -->

    <Style Selector="Border.chatPanel">
      <Setter Property="Background" Value="{DynamicResource ShellChatPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellWindowRadius}" />
      <!-- The sheet stands twelve pixels inside a card that clips its own contents, so a
           shadow is only ever allowed twelve pixels to fall in. A wide one does not fade
           within them: it reaches the card's edge still dark and is cut off there, which is
           a line, not a shadow. This one is close enough to have spent itself by then — and
           light enough to be a lift off the page rather than the dark rim that used to read
           as a second, blacker panel drawn around this one. -->
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow13}" />
    </Style>

    <!-- ================ The assistant widened ================
         Moved out of the planner, the conversation is a panel of its own at 740 — a little
         under the calendar, a little over the report. The card is then the window's, so the
         view gives up the border and the shadow it wears as a sheet: two of each, drawn a
         pixel apart, is the double rim that a re-hosted panel gets for free.

         Width is not the same thing as measure. Everything that is read rather than pointed
         at is held to one column and centred in it — a line of text three hundred pixels wider
         than it should be is harder to read in a bigger window, not easier. The header keeps
         the full width, because it is the window's own top edge and its buttons belong in its
         corner. These rules come after the ones they answer: Avalonia has no specificity, so
         the last style that matches is the one in force. -->
    <Style Selector="local|ChatFlyoutView.chatDocked Border.chatPanel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow0}" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked ScrollViewer.chatColumn">
      <Setter Property="MaxWidth" Value="640" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked Grid.chatColumn">
      <Setter Property="MaxWidth" Value="640" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked StackPanel.chatColumn">
      <Setter Property="MaxWidth" Value="640" />
    </Style>
    <!-- The model card hangs off the switcher in the composer, which has moved inward with the
         column it lives in; the card follows it by exactly that much. -->
    <Style Selector="local|ChatFlyoutView.chatDocked Border.floatingModelCard">
      <Setter Property="Margin" Value="0,0,94,54" />
    </Style>
    <Style Selector="TextBlock.chatTitle">
      <Setter Property="MaxWidth" Value="200" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked TextBlock.chatTitle">
      <Setter Property="MaxWidth" Value="340" />
    </Style>
    <Style Selector="StackPanel.userTurn">
      <Setter Property="MaxWidth" Value="292" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked StackPanel.userTurn">
      <Setter Property="MaxWidth" Value="430" />
    </Style>

    <Style Selector="Border.chatAvatar">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.chatBubble">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.assistantBubble">
      <Setter Property="Background" Value="{DynamicResource ShellChatField}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellAssistantBubbleRadius}" />
    </Style>
    <Style Selector="Border.assistantBubble.errorBubble">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
      <Setter Property="Background" Value="#22FF8295" />
    </Style>
    <Style Selector="Border.userBubble">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellUserBubbleRadius}" />
    </Style>
    <!-- ================ The conversation, read rather than glanced at ================
         Everything below is about the widened panel. The sheet inside the planner is a glance
         at a conversation in a column three hundred pixels wide; the panel is where a
         conversation is actually held, and the two want opposite things from the same view.

         The one decision the rest follow from: in the panel the assistant does not speak from
         inside a box. There is only ever one assistant, its turn is always the full measure of
         the column, and the question above it already sits in a plate — so the border around
         the answer was drawing a frame around the only thing on the page. Taking it away is
         what turns a transcript of two speakers trading cards into a document with a question
         written in the margin of it. Errors keep their plate: an error is the one assistant
         turn that is not simply the next paragraph.

         These rules come after the ones they answer, because Avalonia has no specificity and
         the last matching setter is the one in force. -->
    <Style Selector="local|ChatFlyoutView.chatDocked Border.assistantBubble">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0,0,0" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked Border.assistantBubble.errorBubble">
      <Setter Property="Background" Value="#22FF8295" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <!-- The question, in the one plate on the page. Neutral rather than accented: the accent is
         how this panel says "the assistant is doing something", and a wall of accent-bordered
         plates spends it on the half of the conversation the user already wrote themselves. -->
    <Style Selector="local|ChatFlyoutView.chatDocked Border.userBubble">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Padding" Value="13,10" />
    </Style>
    <!-- Air between turns is what a conversation is punctuated with once the boxes are gone. -->
    <Style Selector="local|ChatFlyoutView.chatDocked Grid.chatTurn">
      <Setter Property="Margin" Value="0,7" />
    </Style>

    <!-- The opening screen. Vertically generous on purpose: it is the whole of what is on the
         panel before the first question, and a greeting pinned to the top of an empty column
         reads as a message that failed to load. -->
    <Style Selector="Border.chatIntro">
      <Setter Property="Padding" Value="16,26,16,18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chatIntroMark">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="TextBlock.chatIntroTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont17}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked TextBlock.chatIntroTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont21}" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked Border.chatIntro">
      <Setter Property="Padding" Value="16,64,16,26" />
    </Style>

    <!-- Back to the newest turn: shown only while the reader is somewhere else in the thread,
         and drawn as a plate rather than a bare glyph because it stands over the conversation
         it is offering to leave. -->
    <Style Selector="Button.scrollToEnd">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ShellIconPrimary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The lift belongs on the presenter: a Button has no shadow of its own. -->
    <Style Selector="Button.scrollToEnd /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow11}" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="Button.scrollToEnd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- What the two keys do. It costs one line of nine-point type and saves the discovery. -->
    <Style Selector="TextBlock.composerHint">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="local|ChatFlyoutView.chatDocked TextBlock.composerHint">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Border.suggestionCard">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.suggestionCard:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <Style Selector="Border.calendarFlyout">
      <Setter Property="Background" Value="{DynamicResource ShellBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="15" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow7}" />
    </Style>
    <Style Selector="Border.count">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Base Button styling and fluent hover layer alignment without clipping -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
      <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
      <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
      <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Primary action buttons -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>
    <Style Selector="Button.primary TextBlock, Button.dangerFilled TextBlock, Button.sendButton TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Secondary buttons -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Quiet buttons -->
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
    </Style>
    <Style Selector="Button.quiet:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.newItemAction">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.newItemAction TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tierBadge">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
    </Style>

    <!-- Danger & Delete actions -->
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <!-- A label written out as a block of its own does not inherit the button's colour: the
         shell-wide rule for text has already given it one. -->
    <Style Selector="Button.danger > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerHover}" />
    </Style>
    <Style Selector="Button.danger:pointerover > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerHover}" />
    </Style>
    <Style Selector="Button.dangerFilled">
      <Setter Property="Background" Value="{DynamicResource ShellDanger}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>
    <Style Selector="Button.dangerFilled:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellDangerHover}" />
    </Style>
    <Style Selector="Button.dangerFilled:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Distinct high-contrast action buttons for list items -->
    <Style Selector="Button.editAction, Button.manageAction">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.editAction:pointerover, Button.manageAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.editAction:pointerover icons|AnimatedIcon, Button.manageAction:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="scale(1.10)" />
    </Style>
    <Style Selector="Button.editAction:pressed /template/ ContentPresenter, Button.manageAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>

    <Style Selector="Button.deleteAction">
      <Setter Property="Background" Value="{DynamicResource ShellDangerTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDangerTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.deleteAction:pointerover">
      <Setter Property="Background" Value="#48FF4D61" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.deleteAction:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="scale(1.10)" />
    </Style>
    <Style Selector="Button.deleteAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>

    <!-- Task check toggle micro-interaction -->
    <Style Selector="Button.checkAction">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.checkAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.checkAction:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="scale(1.14) rotate(-6deg)" />
    </Style>
    <Style Selector="Button.checkAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>

    <!-- Generic icon button -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont14}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeTransparent}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.icon:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="Button.icon.mini">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="Button.icon.micro">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="22" />
    </Style>

    <!-- Close button glyph (cross) micro-interaction: infinite danger shimmer, no background box -->
    <Style Selector="Button.closeGlyph">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.closeGlyph:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.closeGlyph:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.closeGlyph:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg) scale(1.10)" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDangerHover}" />
    </Style>
    <Style Selector="Button.closeGlyph:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>

    <!-- Arrow nudge micro-interactions -->
    <Style Selector="Button.nudgeLeft">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nudgeLeft:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeLeft:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeLeft:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="translate(-2.5px, 0px)" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.nudgeLeft:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <Style Selector="Button.nudgeRight">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nudgeRight:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeRight:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeRight:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="translate(2.5px, 0px)" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.nudgeRight:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <Style Selector="Button.nudgeUp">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nudgeUp:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeUp:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeUp:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="translate(0px, -2.5px)" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.nudgeUp:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <Style Selector="Button.nudgeDown">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nudgeDown:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeDown:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nudgeDown:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="translate(0px, 2.5px)" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.nudgeDown:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <!-- Gear spin micro-interaction -->
    <Style Selector="Button.spinGlyph:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Window.motion Button.spinGlyph:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="rotate(120deg) scale(1.10)" />
    </Style>
    <Style Selector="Button.spinGlyph:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>

    <!-- Send button micro-interaction -->
    <Style Selector="Button.sendButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.sendButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.sendButton:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="translate(0px, -2px) scale(1.08)" />
    </Style>
    <Style Selector="Button.sendButton:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <!-- The same button while a turn is running, when the only press worth offering is the one
         that stops it. Below the rules it overrides: last match wins. -->
    <Style Selector="Button.sendButton.stopButton">
      <Setter Property="Background" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.sendButton.stopButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellDangerHover}" />
    </Style>

    <!-- AI Sparkle action micro-interaction -->
    <Style Selector="Button.sparkleAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Window.motion Button.sparkleAction:pointerover icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="scale(1.18) rotate(10deg)" />
    </Style>
    <Style Selector="Button.sparkleAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Side petals and tabs: in-bounds hover without clipping -->
    <Style Selector="Button.sidePetal">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1,1,0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellPetalRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sidePetal.active">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.sidePetal:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
