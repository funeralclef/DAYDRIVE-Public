      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The line that opens the rest of the shift: a row rather than a button, because what it
         does is unfold the sheet it is part of, not act on the schedule. -->
    <Style Selector="Button.shiftMoreToggle">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.shiftMoreToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.shiftMoreToggle.open">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The chevron lies down when the section is open, so the row says which way it goes. -->
    <Style Selector="Button.shiftMoreToggle icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.shiftMoreToggle.open icons|AnimatedIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Border.shiftDaysValue">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.shiftDateTile">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.shiftDateTile:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.shiftDateTile.active">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="NumericUpDown.shiftAmount">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.shiftApply">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.eventMenuButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.eventMenuButton:pointerover icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>

    <Style Selector="Button.dayActionTile">
      <Setter Property="Width" Value="100" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="MaxWidth" Value="100" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dayActionTile:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.dayOperationsTrigger">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.dayOperationsTrigger:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.dayAction">
      <Setter Property="MinHeight" Value="33" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.dayAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.dayActionFinal">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dayAction.danger:pointerover">
      <Setter Property="Background" Value="#26E45B64" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="Margin" Value="3,2" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>

    <Style Selector="TextBlock.metaLabel">
      <Setter Property="Margin" Value="3,0,0,0" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
    </Style>
    <Style Selector="ComboBox.eventMetaSelector">
      <Setter Property="Height" Value="33" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
    </Style>
    <Style Selector="ComboBox.eventMetaSelector:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="ComboBox.eventMetaSelector:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="ComboBox.taskMetaField">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.eventMetaAccent">
      <Setter Property="Height" Value="2" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.eventGradientGlow">
      <Setter Property="Opacity" Value="0.22" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Window.motion:not(.glass) Border.eventGradientGlow.animated">
      <Style.Animations>
        <Animation Duration="0:0:5.8" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.16" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.58" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.16" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.schedulerGlow">
      <Setter Property="Opacity" Value="0.16" />
    </Style>

    <Style Selector="Border.confirmation">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9" />
    </Style>
    <Style Selector="Border.confirmation.danger"><Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" /></Style>
    <!-- The save question sits inside the composer it belongs to rather than over it, so it is
         held to one line of its own: a full card's worth of padding under a form that is
         already tall pushed the buttons the question is about off the bottom of the panel. -->
    <Style Selector="Border.confirmation.save">
      <Setter Property="Padding" Value="7,6" />
    </Style>
    <Style Selector="Border.confirmation.save Button.compact">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
    </Style>
    <Style Selector="Border.confirmation.save ComboBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
    </Style>

    <!-- Refined Section Toggle Header: Clean gradient illumination, no background box -->
    <Style Selector="Button.sectionToggle">
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sectionToggle:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sectionToggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.sectionToggle TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sectionToggle:pointerover TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.sectionToggle TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sectionToggle:pointerover TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.sectionToggle icons|AnimatedIcon.expandChevron">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sectionToggle:pointerover icons|AnimatedIcon.expandChevron">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="Button.sectionToggle:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.taskBlockAction">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
    </Style>
    <Style Selector="Button.taskBlockAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.taskBlockAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <Style Selector="Border.taskBlockEditor"><Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow6}" /></Style>
    <Style Selector="Button.eventDateField"><Setter Property="Padding" Value="8,7" /></Style>
    <Style Selector="Button.timeField">
      <Setter Property="Padding" Value="7" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont13}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.timeStep">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.timeWheelColumn">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.timeWheelColumn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
    </Style>
    <Style Selector="Button.periodToggle">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.periodToggle:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <Style Selector="TextBlock.calendarWeekday">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
    <Style Selector="TextBox, ComboBox, TimePicker">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
    </Style>
    <Style Selector="TimePicker:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- A box that takes newlines is a box somebody is writing a paragraph in, and Avalonia's
         default is NoWrap: what they typed ran off to the right in one line and scrolled the
         field sideways under the caret, so the beginning of their own sentence went off the
         screen while they were still writing the end of it. Every one of them wraps now - the
         composer, a question being rewritten, the notes on an event, the assistant's standing
         instructions - and the rule is written against the property rather than against a list
         of names, so the next one to be added wraps without anybody remembering to say so.
         Above the composer's own rules below, which need to be able to say otherwise. -->
    <Style Selector="TextBox[AcceptsReturn=True]">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The composer is one field inside a card that is itself the field: the card carries the
         edge, the fill and the focus colour, and the box inside it carries nothing at all.
         These have to be declared under the shell-wide text-box rules above rather than over
         them — a bare TextBox selector matches this box too, and the last matching setter is
         the one that lands, which is how a lit rectangle used to appear inside the composer
         the moment the pointer crossed it. -->
    <Style Selector="TextBox.composerInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="TextBox.composerInput /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composerInput:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composerInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composerInput:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Popup sizing and placement stay under the native ComboBox template. Its brushes and
         radius are supplied by the dynamic theme resources in ShellThemeService. -->
    <Style Selector="ComboBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>
    <Style Selector="ComboBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="CheckBox:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="RenderTransform" Value="scale(1.0)" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHover}" />
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="CheckBox /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
      <Setter Property="RenderTransform" Value="scale(1.0)" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:unchecked /template/ Path#CheckGlyph">
      <Setter Property="RenderTransform" Value="scale(0.7)" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll">
      <!-- Keep the narrow channel reserved so content does not jump or become asymmetric
           when a scrollbar changes between needed and not needed. The bar itself stays hidden. -->
      <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
      <Setter Property="AllowAutoHide" Value="False" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="icons:CapsuleScrollBehavior.IsEnabled" Value="True" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="AllowAutoHide" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Margin="1,8">
            <Border Classes="capsuleScrollRail"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ShellAccentSoft}"
                    CornerRadius="999" />
            <Track Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   Orientation="Vertical"
                   IsDirectionReversed="True">
              <Track.ViewportSize>
                <MultiBinding Converter="{StaticResource CompactScrollViewportConverter}">
                  <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </Track.ViewportSize>
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Focusable="False" Opacity="0"
                              MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0"
                              Background="Transparent">
                  <RepeatButton.Template>
                    <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Focusable="False" Opacity="0"
                              MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0"
                              Background="Transparent">
                  <RepeatButton.Template>
                    <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Thumb Classes="capsuleScrollThumb"
                     MinHeight="22"
                     BorderThickness="0.6"
                     CornerRadius="999"
                     Cursor="Hand">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            BoxShadow="{DynamicResource MarelianShadow1}" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ScrollViewer.modernScroll.scrollVisible /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Opacity" Value="0.76" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll /template/ ScrollBar#PART_VerticalScrollBar:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll.scrollInteracting /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll /template/ ScrollBar#PART_VerticalScrollBar:disabled">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.capsuleScrollRail">
      <Setter Property="Width" Value="4" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Border.capsuleScrollRail">
      <Setter Property="Opacity" Value="0.20" />
      <Setter Property="Width" Value="4" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll.scrollInteracting /template/ ScrollBar#PART_VerticalScrollBar /template/ Border.capsuleScrollRail">
      <Setter Property="Opacity" Value="0.20" />
      <Setter Property="Width" Value="4" />
    </Style>
    <Style Selector="Thumb.capsuleScrollThumb">
      <Setter Property="Width" Value="4.5" />
      <Setter Property="Opacity" Value="0.48" />
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentGlow}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1,0.72)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Thumb.capsuleScrollThumb:pointerover">
      <Setter Property="Width" Value="5.4" />
      <Setter Property="Opacity" Value="0.90" />
      <Setter Property="RenderTransform" Value="scale(1,1)" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Thumb.capsuleScrollThumb:pressed">
      <Setter Property="Width" Value="5.8" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1,1.04)" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentDeep}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentGlow}" />
    </Style>
    <Style Selector="ScrollViewer.modernScroll.scrollInteracting /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb.capsuleScrollThumb">
      <Setter Property="Width" Value="5.8" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1,1.04)" />
    </Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
    </Style>


    <!-- ===================== Chat surface ===================== -->
    <Style Selector="Border.chatHeader">
      <Setter Property="Background" Value="{DynamicResource ShellChatField}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellTopRadius}" />
    </Style>
    <Style Selector="Button.chatHeaderButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>
    <Style Selector="Button.chatHeaderButton.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.chatHeaderButton.active icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- Message affordances stay quiet until the row is hovered. -->
    <Style Selector="StackPanel.messageActions">
      <Setter Property="Opacity" Value="0.25" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.messageActions:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid:pointerover StackPanel.messageActions">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.messageAttachment">
      <Setter Property="Background" Value="#26000000" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,4" />
    </Style>

    <Style Selector="Button.traceToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.traceToggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.traceRow">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.traceRow.failed">
      <Setter Property="Background" Value="#22FF8295" />
    </Style>

    <Style Selector="Border.stagePill">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <!-- ===================== What the assistant is allowed to do ===================== -->
    <!-- Shared permission cards and the compact picker in the composer. -->
    <Style Selector="Border.schedulerStepChip">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow8}" />
    </Style>
    <Style Selector="Border.schedulerStepChip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>

    <Style Selector="Button.accessPicker">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MaxWidth" Value="140" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.accessPicker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.accessOption">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,10" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.accessOptionTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.accessOptionHint">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.accessOption icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.accessOption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.accessOption.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.accessOption.selected icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- ===================== History and memory drawers ===================== -->
    <Style Selector="Border.searchField">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="TextBox.bareInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.bareInput /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.emptyHint">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,18" />
      <Setter Property="Margin" Value="0,10,5,0" />
    </Style>
    <Style Selector="Border.conversationRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.conversationRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
    </Style>
    <Style Selector="Border.conversationRow.selected">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.conversationOpen">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.conversationOpen:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.memoryBanner">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,9" />
    </Style>
    <Style Selector="Border.memoryBannerMark">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.memoryCount">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.memoryCount TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.memoryRow">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.memoryRow:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- Set aside rather than deleted: still legible, plainly not in play. -->
    <Style Selector="Border.memoryRow.muted">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="Border.memoryRow Border.memoryRail">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,1,0,1" />
    </Style>
    <Style Selector="Border.memoryRow.muted Border.memoryRail">
      <Setter Property="Background" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="CheckBox.memorySwitch">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1,2,0" />
    </Style>
    <Style Selector="Border.memoryComposer">
      <Setter Property="Background" Value="{DynamicResource ShellChatField}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.memoryComposer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- Rewriting a turn in place. The bubble is the frame, so the box inside it is only the
         caret and the words. -->
    <Style Selector="TextBox.messageEditor">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont12_5}" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox.messageEditor /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.messageEditor:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>


    <!-- ===================== Analytics ===================== -->
    <Style Selector="Border.metricTile">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="82" />
    </Style>
    <Style Selector="Border.factChip">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,7" />
    </Style>
    <Style Selector="Border.chartCard">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Bars carry the value through height. The width now comes from the column they sit in,
         because it depends on how many columns there are: seven fixed pixels each drew a
         readable week, a cramped month, and ninety-one overlapping slivers for a quarter. -->
    <Style Selector="Border.chartBar">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="3,3,1,1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.42" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.chartBar.scheduled">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.chartBar.scheduled.today">
      <Setter Property="Opacity" Value="0.66" />
    </Style>
    <Style Selector="Border.chartBar.completed">
      <Setter Property="Background" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <!-- A column lights its bars when the pointer is anywhere in its lane, not only on the
         few pixels the bar itself occupies. -->
    <Style Selector="Grid:pointerover > Panel > Border.chartBar.scheduled">
      <Setter Property="Opacity" Value="0.74" />
    </Style>

    <Style Selector="Border.chartGridline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.chartBaseline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
    </Style>
    <Style Selector="TextBlock.gridlineLabel">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont8_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="Opacity" Value="0.72" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chartUnitChip">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Border.legendSwatch">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Border.legendSwatch.scheduled">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.legendSwatch.completed">
      <Setter Property="Background" Value="{DynamicResource ShellSuccess}" />
    </Style>

    <!-- The wedge itself is grown rather than faded: the geometry carries the arrival, and the
         opacity only has to cover the frame a wedge first becomes non-empty on. -->
    <Style Selector="Path.donutSlice">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- The donut's legend. Four fixed measures per line, mirrored either side of the ring, so
         six categories read as one table rather than six separate sentences. -->
    <Style Selector="TextBlock.sliceLabel">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The hours are the measurement behind the share, so they are set the way every other
         measurement in this window is: in a quiet chip, not as loose grey text run up against
         the number it is explaining. -->
    <Style Selector="Border.sliceHours">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.sliceHoursText">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.slicePercent">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sliceSwatch">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.hourBar">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="3,3,1,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.34" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.hourBar.busiest">
      <Setter Property="Background" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Border.weekdayTrack">
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.weekdayBar">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Opacity" Value="0.62" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.weekdayBar.busiest">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.todayTick">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The range list: what "week", "month" and "three months" actually cover. -->
    <Style Selector="Button.rangePicker">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="MinWidth" Value="136" />
    </Style>
    <Style Selector="Button.rangePicker:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rangePicker.open /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- A menu is read, not looked through: the popup layer rather than the surface layer. -->
    <Style Selector="Border.rangeList">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="212" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow5}" />
    </Style>
    <Style Selector="Button.rangeOption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.rangeOption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
    </Style>
    <Style Selector="Button.rangeOption.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <Style Selector="Border.insightCard">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style Selector="Border.insightGlyph">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#2EFF8295" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.insightGlyph.positive">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoft}" />
    </Style>

    <!-- ===================== Schedule surface polish ===================== -->
    <Style Selector="Border.agendaCard">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.agendaCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
    </Style>
    <Style Selector="Border.agendaCard.current">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.agendaCard.past">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- A reminder landed about this event while the shell was open.
         Below the two rules above rather than beside them: styles here are last-match-wins, not
         most-specific-wins, so a mark that has to survive on a row already lit as "now" has to
         be said after the rule that lights it.

         It is the card's own two brushes and nothing else. Both already carry a transition, so
         the mark arrives over a sixth of a second and leaves the same way when the shell drops
         it six seconds later — which is the whole of "a light accent on the event": the row the
         reminder is about warms up, and the user's eye goes to it without anything having
         appeared on top of what they were reading. -->
    <Style Selector="Border.agendaCard.flash">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.agendaRail">
      <Setter Property="Width" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <!-- The rail is the one part of the row that is already the event's own colour, so the
         breathing goes there rather than on the row: a list whose rows change opacity reads as
         flicker, and a stripe that pulses twice reads as a nudge. -->
    <Style Selector="Window.motion Border.agendaCard.flash Border.agendaRail">
      <Style.Animations>
        <Animation Duration="0:0:0.85" IterationCount="4" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- ===================== Row tags =====================
         Every mark a card puts under its title is the same box. It was five separate styles
         with three paddings, two corner radii and four type sizes between them: "now" stood a
         pixel and a half shorter than the category chip beside it, "done" a pixel taller than
         either because it was the only one with an edge, and a row wearing three of them read
         as three different kinds of label rather than one row of tags.

         So the box is settled here once - one height, one corner, one measure of type, and an
         edge on every tag whether or not that edge is coloured - and each tag below says only
         what colour it is. A fixed height rather than padding around the text, because the tags
         carry different scripts and one word in a taller script is the other way a row of
         labels goes ragged. -->
    <Style Selector="Border.rowTag">
      <Setter Property="Height" Value="19" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rowTag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="LineHeight" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.rowTag icons|AnimatedIcon">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.durationPill">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Border.nowPill">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.nowPill TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The category's own colour arrives on the element as a binding; the class is here so the
         chip is named the same way as the tags beside it. -->
    <Style Selector="Border.categoryChip">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.deadlineChip">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Border.deadlineChip.overdue">
      <Setter Property="Background" Value="#2EFF8295" />
    </Style>
    <!-- The date on a wrap-up line that is older than today. It wears the warning colour
         because that is what the line is: something that has been waiting. -->
    <Style Selector="Border.wrapUpDay">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="Border.wrapUpDay TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Border.priorityDot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.rowActions">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border:pointerover StackPanel.rowActions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.nowLine">
      <Setter Property="Background" Value="{DynamicResource ShellDanger}" />
      <Setter Property="Height" Value="1.5" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Border.nowDot">
      <Setter Property="Background" Value="{DynamicResource ShellDanger}" />
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- A real thumbnail of the attached image, clipped to the chip's corner radius. -->
    <Style Selector="Border.attachmentThumb">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
    </Style>

    <!-- ===================== AI provider chooser ===================== -->
    <Style Selector="Button.providerCard">
      <Setter Property="Height" Value="66" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.providerCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.providerCard.active">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.providerCard.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.providerCard:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- ===================== About ===================== -->
    <Style Selector="Border.aboutHero">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellWindowRadius}" />
      <Setter Property="Padding" Value="18,20" />
    </Style>
    <Style Selector="Border.aboutMark">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="54" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- A slow breath, not a spinner: the mark is decoration, not a progress indicator. -->
    <Style Selector="Window.motion Border.aboutMark">
      <Style.Animations>
        <Animation Duration="0:0:3.4" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.86" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.aboutTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont22}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2.4" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Border.aboutAuthor">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="12,11" />
    </Style>
    <Style Selector="Border.aboutAvatar">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.aboutLink">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.aboutLink:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.aboutLink icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.aboutLink:pointerover icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- ===================== Release notice ===================== -->
    <Style Selector="Border.updateBanner">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="12,11" />
    </Style>
    <Style Selector="Border.updatePulse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Window.motion Border.updatePulse">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The only ambient signal a pending release gets: a dot on the settings petal. -->
    <Style Selector="Border.updateDot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,9,0,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ===================== Hover widget =====================
         Modular by intent. With nothing running the widget is a single small block — clock, date
         and one line about what is next. An event brings out two more blocks and the control
         rail, and takes them away again once it is reported on. Each block is its own floating
         surface, so the gaps between them are desktop rather than panel, which is what keeps the
         quiet state genuinely quiet instead of a large card with empty rows in it. -->

    <!-- The card draws nothing of its own. It exists so the widget can be faded, scaled and
         moved as one object, and so the pointer keeps slack around the blocks. The padding is
         also the room the blocks' shadows fall into: clipped at the window edge they read as a
         hard-cornered dark plate under the widget rather than as shadow at all.

         The move itself belongs to the shared WindowRevealAnimator, the same one that brings the
         shell and the panels in: it owns the opacity, the transform and the transitions, so the
         widget and the panels are one gesture rather than two that happen to point the same way.
         Only the resting state is declared here, for the frames before the first reveal. -->
    <Style Selector="Border.peekCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="RenderTransformOrigin" Value="100%,50%" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Where the model is running, said in two or three letters. Lit only when it really is
         on the card: the badge is a report, not a setting. -->
    <Style Selector="Border.acceleratorBadge">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,1" />
    </Style>
    <Style Selector="Border.acceleratorBadge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.acceleratorBadge.gpu">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.acceleratorBadge.gpu TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- ===================== The petal ===================== -->
    <!-- A floating capsule beside the right-hand edge, with symmetric corners in both states.
         Its placement keeps a small gap between the capsule and the screen.

         At rest it is eight pixels of accent at a seventh of full strength: present enough to be
         aimed at, quiet enough to be forgotten. With a session running it widens and
         becomes a small dark capsule with the clock in it. That is the entire difference, and it
         is carried by the transitions below rather than by anything that touches the window —
         the window is placed once and left alone, because a window that resizes itself on this
         edge fights the placement of every other surface standing on it. -->
    <Style Selector="Border.edgePetal">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <!-- The rim is the accent at rest, which is to say nothing at all; a brush transition is
           what brings it in. It starts from the stroke at zero alpha rather than from
           "Transparent", which in this framework is transparent *white* and would run the fade
           through a grey flash. -->
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStrokeTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="0.14" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <!-- A class rather than :pointerover, because at rest the capsule is a quarter of what
         answers the pointer: the platform will not make the window as narrow as the sliver, and
         the difference is reach that belongs to the petal. The pseudo-class would leave the
         petal dark while the pointer is demonstrably on the petal. -->
    <Style Selector="Border.edgePetal.hover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <!-- Declared after the hover rule on purpose: a petal carrying a session is already at full
         strength, and this framework settles a conflict by taking the last rule that matches
         rather than the most specific one. -->
    <Style Selector="Border.edgePetal.live">
      <Setter Property="Background" Value="{DynamicResource ShellPopupBlur}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Window.motion Border.edgePetal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
          <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.32" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.28" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.28" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- All three pairs share the same weight and colour; tabular figures keep them stable. -->
    <Style Selector="TextBlock.petalDigits">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont13}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="+tnum,-kern" />
      <Setter Property="Height" Value="{DynamicResource MarelianFont16}" />
      <Setter Property="LineHeight" Value="{DynamicResource MarelianFont16}" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!-- A held stopwatch and a running one look identical for the fifty-nine seconds between two
         changes of the minutes, and the seconds are the only thing on a surface this small that
         would have said which. So standing still is said in colour instead. -->
    <Style Selector="TextBlock.petalDigits.held">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <!-- The clock waits for the capsule to have somewhere to put it. The hold at the front of
         the timeline is that waiting: a transition with a delay would also delay the way out,
         and the way out is the whole reading leaving the screen.

         The last keyframe is the value the reading rests at, so the forward fill costs nothing
         once the class stops matching. -->
    <Style Selector="Window.motion StackPanel#Readout.on">
      <Style.Animations>
        <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The rail beside the petal. It draws nothing itself: the seats are the surfaces, exactly
         as they are on the quick widget, and this only gives their shadows room to fall and
         gives the pointer somewhere to be on the way between the petal and the keys. -->
    <Style Selector="Border.petalRailCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="RenderTransformOrigin" Value="100%,50%" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- ===================== The tray menu ===================== -->
    <!-- Kept to the size of a menu rather than of a panel: a row is a row of text and the space
         to press it, and the lengths a quiet spell can be set to live behind one line that
         opens instead of five that are always there. -->
    <Style Selector="Border.trayMenuCard">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="186" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow2}" />
    </Style>
    <Style Selector="Button.trayMenuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.trayMenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <!-- The line a submenu hangs off stays lit while that submenu is open, so the indented
         lines below it read as belonging to it rather than to the menu. -->
    <Style Selector="Button.trayMenuItem.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="ItemsControl.trayMenuSubmenu">
      <Setter Property="Margin" Value="13,1,0,3" />
    </Style>
    <Style Selector="Button.trayMenuChild">
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="TextBlock.trayMenuDetail">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
    </Style>
    <Style Selector="TextBlock.trayMenuCaption">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="7,5,7,2" />
    </Style>
    <Style Selector="Button.trayMenuItem icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- Below the rule above on purpose: styles here are last-match-wins, not most-specific-wins,
         so a chevron that is not an accent has to be said after the rule that makes icons one. -->
    <Style Selector="icons|AnimatedIcon.trayMenuChevron">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.trayMenuSeparator">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="7,3" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
    </Style>

    <Style Selector="Border.peekBlock">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="Padding" Value="13,10" />
      <!-- Offset plus blur has to fit inside the card's padding, or the window clips the
           shadow and the cut edge shows as a straight dark border under the blocks. -->
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow14}" />
      <!-- The blocks below the clock grow downwards, out from under it. -->
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
    </Style>
    <!-- One line, so it gets a tighter box than the blocks that carry a heading. -->
    <Style Selector="Border.peekBlock.nextBlock">
      <Setter Property="Padding" Value="11,8" />
    </Style>
    <!-- ===================== Reminders, on the event card ===================== -->
    <!-- A reminder accents the event card. The dismiss petal floats beside its left edge. -->
    <Style Selector="Window.motion Border.peekBlock.eventBlock">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.26" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.peekBlock.eventBlock.notified">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- The reminder's own sentence, for the one case where the card has no lines of its own to
         put it on: a reminder about an event the widget was not describing. -->
    <Style Selector="TextBlock.peekReminderText">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="LineHeight" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="3" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>

    <Style Selector="Button.peekDismiss">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.peekDismiss:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.peekDismiss:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- A reminder taking the card over, and a second one taking it over from the first. It
         plays on what the card says rather than on the card, so the block does not move, the
         widget does not resize and nothing on the screen shifts under the pointer — the card
         simply re-forms around a new sentence. -->
    <Style Selector="Window.motion StackPanel.peekEventBody.arriving">
      <Style.Animations>
        <!-- The text catches up rather than trailing: faded in over the whole move it spent its
             first fifth of a second invisible, which reads as the widget stalling. -->
        <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-7" />
          </KeyFrame>
          <KeyFrame Cue="45%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="-2" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The clock block hands its padding to the button that fills it. -->
    <Style Selector="Border.peekBlock.flush">
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The whole block is the button, and the alignment setters are what make it fill the
         block rather than stopping at the width of its own content. It stays flat under the
         pointer: the widget is a small pane that appears under the cursor and disappears again,
         and a wash arriving over the clock as it lands reads as the thing flashing at you
         rather than as a hover. Pressing it still answers — the content dips — and that is the
         one moment feedback is actually being asked for. -->
    <Style Selector="Button.peekBlockFill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.peekClock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont29}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="33" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <!-- "11:57 PM" against "23:57": the same size in the same column would run under the
         creature, so the twelve-hour reading is set smaller instead of being cut off. -->
    <Style Selector="TextBlock.peekClock.twelveHour">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont22}" />
      <Setter Property="LineHeight" Value="26" />
    </Style>
    <Style Selector="TextBlock.peekCaption">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Small, quiet, and the only thing that distinguishes a running event from one that
         finished an hour ago and still has no verdict. -->
    <Style Selector="TextBlock.peekEyebrow">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont8_8}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- One line, cut off where the block ends. It used to wrap to two, which made the widget a
         different height for a long name than for a short one — and the widget is centred on its
         own edge, so the block under it moved up the screen because an event happened to be
         called something long. A name that does not fit is a name the user already knows; the
         first line of it is what identifies the event, and the shell has the whole of it. -->
    <Style Selector="TextBlock.peekEventTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont15}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.peekEventTitle.reminder">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="3" />
    </Style>
    <Style Selector="TextBlock.peekTimerValue">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont13}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="TextBlock.peekTimerValue.waiting">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>

    <Style Selector="Border.peekLiveDot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource ShellMuted}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.peekLiveDot.live">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Only the dot keeps moving once the widget has settled, and only while something is
         actually running. Everything else in it is still. -->
    <Style Selector="Window.motion Border.peekLiveDot.live">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.peekChip">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- The row under the event's hours: a line of muted type, not a chip. It is written here
         rather than on the element because a margin in the XAML is a local value no style can
         get past - and because everything above it is what this row is deliberately not. -->
    <Style Selector="Border.peekChip.stateChip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.peekChip.stateChip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.peekChip.stateChip icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <!-- The one chip on the card that comes and goes while the widget stands still: a session
         starting puts it there, a verdict takes it away. It used to arrive in a single frame in
         the middle of a block that was growing by its height at the same moment. Class-driven,
         for the same reason the rail's keys are: a selector that matches a chip already sitting
         hidden in the tree has run long before the chip is shown. -->
    <Style Selector="Window.motion Border.peekChip.stateChip.on">
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-5" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.peekChip.danger">
      <Setter Property="Background" Value="#2EFF8295" />
    </Style>
    <Style Selector="Border.peekChip.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <!-- Nothing is overdue. Same chip, same place, so the eye reads one line either way. -->
    <Style Selector="Border.peekChip.ok">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoft}" />
    </Style>
    <Style Selector="Border.peekChip.ok TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <!-- Between the two: nothing is late, but the day is carrying work that was skipped, half
         done, or never answered for. The chip used to have no way of saying that, so it said
         everything was fine. -->
    <Style Selector="Border.peekChip.warning">
      <Setter Property="Background" Value="#2EF4B860" />
    </Style>
    <Style Selector="Border.peekChip.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>

    <Style Selector="ProgressBar.peekProgress">
      <Setter Property="Height" Value="2" />
      <Setter Property="MinHeight" Value="2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <!-- The share is recomputed on the shell's one-second clock, so without this the bar stepped
         once a second while the digits above it counted smoothly - the same reading given twice
         in two different tempos. Carried across the step it simply advances, which is what the
         event it is measuring is doing. -->
    <Style Selector="Window.motion ProgressBar.peekProgress">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:1" Easing="LinearEasing" />
        </Transitions>
      </Setter>
    </Style>

    <!-- The rail. Icon-only, but on 30 px targets with names in the tooltips, which is a
         different thing from the four 10 px glyphs it replaced.

         It is a column and nothing else now: no surface, no edge, no shadow. What the eye reads
         as the rail is the circles standing in it, each one a small round key of its own with
         its own edge and its own lift off the page. One plate under the lot of them said they
         were one control with parts, which is the opposite of what they are - and it put a
         fourth surface beside the three blocks that already carry their own. -->
    <Style Selector="Border.peekRail">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,9,0" />
      <Setter Property="RenderTransformOrigin" Value="100%,50%" />
    </Style>
    <!-- One key. The seat is the round surface and its edge; the button sits inside it and is
         only ever the light that comes on under the pointer, which is why the shadow lives out
         here - a button hands its background to the presenter in its template, and there is no
         presenter anywhere that draws a shadow. -->
    <Style Selector="Border.peekRailSeat">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow12}" />
    </Style>
    <!-- Set down from the session's own controls: the space is the grouping. -->
    <Style Selector="Border.peekRailSeat.apart">
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- A key arriving. The rail is not a fixed set of buttons — pressing start takes the start
         key away and puts a hold and a stop in its place — and all of that used to happen in one
         frame: a key vanished, two appeared at full size, and the column jumped. The seats carry
         no transition of their own because visibility cannot have one, so the arrival is a style
         animation and the class that plays it is bound to the same answer as the visibility. The
         two flip together, the animation's selector starts matching, and the key grows into the
         space instead of being dropped into it.

         Its final keyframe is the seat's own resting state, so the forward fill costs nothing
         once the class stops matching and the key goes. -->
    <Style Selector="Window.motion Border.peekRailSeat.on">
      <Style.Animations>
        <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.45" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.45" />
          </KeyFrame>
          <KeyFrame Cue="65%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.06" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.06" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The resting background is the accent at zero alpha rather than "Transparent", and that
         is not a nicety: Avalonia's Transparent is transparent *white*, and a brush transition
         from it to the accent wash runs through half-alpha white. On a 30 px black key that is
         a bright grey flash on the way in, every time the pointer arrives - which is what the
         hover on these buttons actually looked like. Everything else in the shell already fades
         from ShellAccentTransparent for exactly this reason; the rail was the one place that
         did not. -->
    <Style Selector="Button.peekRailButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.peekRailButton:disabled">
      <Setter Property="Opacity" Value="0.32" />
    </Style>
    <Style Selector="Button.peekRailButton:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.88)" />
    </Style>
    <Style Selector="Button.peekRailButton.start icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.peekRailButton.start:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.peekRailButton.undo">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAltTransparent}" />
    </Style>
    <Style Selector="Button.peekRailButton.undo icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.peekRailButton.undo:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
    </Style>

    <!-- The entrance. One timeline shared by every part, with each part held at its starting
         value until its turn comes, rather than several animations on separate delays: a delayed
         animation shows its element at full strength while it waits, which is exactly the flicker
         this is meant to avoid. The clock lands first, the event block slides out from under it,
         the countdown follows, then what comes next, and the rail comes out from behind the
         stack.

         It runs on 0.32 s against the card's own 0.26 s, so the blocks settle inside the card's
         arrival instead of after it. At 0.42 s the two clocks were plainly different lengths and
         the widget read as slower than every other surface despite starting at the same moment;
         the distances are shorter for the same reason — the panels travel 22 px, and there is no
         reason for the smallest thing on screen to travel further than they do.

         The class is on each part rather than on the card above them, and that is load-bearing.
         Hung off the card as a descendant selector, every block got an entrance whether or not
         it was on the screen — and a block that is not on the screen never gets the frames to
         play one. It stopped on the animation's first keyframe, which is zero opacity, and kept
         it after the class came off: the countdown that comes back when a verdict is undone
         arrived invisible while still taking up its full height, which is the widget with a
         hole in it. The code behind puts the class only on the parts that are actually
         arriving; see QuickPeekWindow.MarkEntrance. -->
    <Style Selector="Window.motion Border.clockBlock.revealing">
      <Style.Animations>
        <Animation Duration="0:0:0.32" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="14" />
          </KeyFrame>
          <KeyFrame Cue="52%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Grid.peekEventFrame.revealing">
      <Style.Animations>
        <Animation Duration="0:0:0.32" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-12" />
          </KeyFrame>
          <KeyFrame Cue="16%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-12" />
          </KeyFrame>
          <KeyFrame Cue="66%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border.nextBlock.revealing">
      <Style.Animations>
        <Animation Duration="0:0:0.32" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-16" />
          </KeyFrame>
          <KeyFrame Cue="40%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-16" />
          </KeyFrame>
          <KeyFrame Cue="90%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border.peekRail.revealing">
      <Style.Animations>
        <Animation Duration="0:0:0.32" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="18" />
          </KeyFrame>
          <KeyFrame Cue="24%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="18" />
          </KeyFrame>
          <KeyFrame Cue="74%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The widget opening out of the compact shape a reminder put it in. The two blocks that
         were already there — the card and the countdown under it — do not move at all: the
         placement pins the card to the screen for the length of this, so the widget grows around
         the thing the user is reading rather than sliding it up the monitor.

         What arrives is everything the reminder had no claim on, each from behind whatever was
         hiding it: the clock up out of the card, what comes next down out of the countdown, the
         rail sideways out from behind the stack. Shorter travel than the entrance and no stagger
         worth the name — this is not the widget arriving, it is the widget it already was
         becoming whole, and a second choreography for that would be one too many. -->
    <Style Selector="Window.motion Border.clockBlock.unfolding">
      <Style.Animations>
        <Animation Duration="0:0:0.36" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="14" />
          </KeyFrame>
          <KeyFrame Cue="72%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border.peekRail.unfolding">
      <Style.Animations>
        <Animation Duration="0:0:0.36" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="16" />
          </KeyFrame>
          <KeyFrame Cue="14%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="16" />
          </KeyFrame>
          <KeyFrame Cue="82%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.motion Border.nextBlock.unfolding">
      <Style.Animations>
        <Animation Duration="0:0:0.36" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-14" />
          </KeyFrame>
          <KeyFrame Cue="22%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-14" />
          </KeyFrame>
          <KeyFrame Cue="88%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>


    <!-- ===================== Event fixation ===================== -->
    <!-- The verdict wears the row-tag box like everything else on the row; only where it is
         used on its own, away from a row of tags, does it keep a shape of its own. -->
    <Style Selector="Border.outcomeChip">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.outcomeChip.rowTag">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style Selector="Border.outcomeChip icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.outcomeChip.skipped">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
    </Style>
    <Style Selector="Border.outcomeChip.skipped TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.outcomeChip.skipped icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>

    <!-- Per-row fixation. Every event that has begun carries its own controls, which is what
         makes a past day, or something that finished hours ago, markable at all. -->
    <Style Selector="Button.rowTrackToggle">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.agendaCard:pointerover Button.rowTrackToggle">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.rowTrackToggle.marked">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The same button, one place along: "there is a note about this event that the row is
         not showing". It says the same kind of thing the pin does, so it is the same shape. -->
    <Style Selector="Button.rowTrackToggle.note">
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.rowTrackToggle.note icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rowTrackToggle:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rowTrackToggle.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Window.reduceMotion Button.rowTrackToggle">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Match the card's inner curve, including custom theme radii. A fixed tray radius paints
         over the outline when the surrounding card is rounder. Its edge is one DIP thick. -->
    <Style Selector="Border.rowTrackTray">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardInnerBottomRadius}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Window.motion Border.rowTrackTray">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Button.rowTrackAction">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowTrackAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rowTrackAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.rowTrackAction:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.rowTrackAction.start icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rowTrackAction.done icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.rowTrackAction.partial icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="Button.rowTrackAction.skip icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.rowTrackAction.session">
      <Setter Property="Width" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.rowTrackAction.session icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rowTrackAction.pause icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.rowTrackAction.stop icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.rowTrackAction.undo">
      <Setter Property="Width" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>

    <!-- The chip carries the verdict's own colour, so a glance down the day reads as a summary. -->
    <Style Selector="Border.outcomeChip.rowOutcome.done">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Border.outcomeChip.rowOutcome.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Border.outcomeChip.rowOutcome.partial">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="Border.outcomeChip.rowOutcome.partial TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>

    <Style Selector="Border.dayProgressTrack">
      <Setter Property="Width" Value="66" />
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ProgressBar.dayProgress">
      <Setter Property="Height" Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.unmarkedChip">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Picking events, and moving them ===================== -->
    <!-- A finished event nobody answered for. The pin is normally almost invisible until the
         row is hovered; on these it is not, because that row is the one thing the day is
         still waiting on. -->
    <Style Selector="Button.rowTrackToggle.missing">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
    </Style>

    <!-- The selection bar is a strip, not a card: one line high, quiet enough to sit between
         the day's heading and the day itself, and marked as a mode by the accent edge down its
         left rather than by a border drawn all the way round it. -->
    <Style Selector="Border.selectionBar">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="7,5" />
    </Style>
    <!-- "All" and "Clear" change what is chosen rather than doing anything to it, so they are
         set as words rather than as buttons. -->
    <Style Selector="Button.selectionLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.selectionLink:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <!-- "Everything is already selected" is a word that has nothing left to do, not a filled
         button. The theme's own disabled background has to be turned off by hand, or it draws
         the plate this style spent its other setters removing. -->
    <Style Selector="Button.selectionLink:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.selectionLink:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <!-- The three verbs. Icon-sized, because at this width a row of labelled buttons is the
         bar again — and each one carries the label it dropped as its tooltip. -->
    <Style Selector="Button.selectionAction">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="MinWidth" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.selectionAction.move:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.selectionAction.remove">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.selectionAction.remove:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.selectionAction.done">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.selectionAction.done:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.selectionAction:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="Window.motion Border.selectionBar">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-6" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The tick box lives where the accent rail already draws a vertical edge, so a row in
         selection mode grows one column rather than rearranging itself. -->
    <Style Selector="CheckBox.rowSelect">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="9,0,0,0" />
    </Style>

    <Style Selector="Border.dayReviewChip">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Border.dayReviewChip.strong">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.eventMoveSheet">
      <!-- The most opaque of the shell's layers: this sheet is the one that stands over the day
           list, and a list of times reading through the times it is about is unreadable. It
           carries the same shadow as the other sheets — a deeper one drew a dark halo around
           the card that read as a plate under it rather than as depth. -->
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellWindowRadius}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow16}" />
    </Style>
    <Style Selector="Border.movePreview">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="11,8" />
    </Style>
    <Style Selector="Border.collisionCard">
      <Setter Property="Background" Value="#1FFF8295" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="Button.nudgeChip">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nudgeChip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- ===================== Settings rows ===================== -->
    <!-- One consistent stack for label + control + hint. The old layout used negative
         margins to pull hints upwards, which is what made controls overlap. -->
    <Style Selector="StackPanel.settingRow">
      <Setter Property="Spacing" Value="5" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="15" />
    </Style>

    <!-- ===================== Shortcuts ===================== -->
    <!-- A row is what it does and the key that does it. The key is a button, because it is the
         thing you press to change it — a separate "change" button beside a label would be one
         more control for a page that is already six rows of them. -->
    <Style Selector="Grid.shortcutRow">
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <!-- Monospaced digits and a fixed width, so six rows of different-length combinations line
         up as a column rather than as six differently sized buttons. -->
    <Style Selector="Button.shortcutKey">
      <Setter Property="MinWidth" Value="128" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>
    <Style Selector="Button.shortcutKey:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- Listening. The row is the only thing on the page that answers the keyboard now, and it
         has to look like it is waiting rather than like it has been selected. -->
    <Style Selector="Button.shortcutKey.listening">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Window.motion Button.shortcutKey.listening">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.6" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Below the listening rule on purpose: styles here are last-match-wins, and a combination
         that is not going to work should say so even while the row is being changed. -->
    <Style Selector="Button.shortcutKey.wrong">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="TextBlock.shortcutProblem">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Aligns a hint under the label of the checkbox it belongs to. -->
    <Style Selector="TextBlock.hint.indented">
      <Setter Property="Margin" Value="26,0,0,0" />
    </Style>
    <Style Selector="TextBlock.paramValue">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.fontPreview">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="Button.modelCard.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <!-- Keep each theme on one radius scale. Special shapes such as circular chat buttons,
         pills and one-sided tabs remain intentional exceptions. -->
    <Style Selector="Border.calendarFlyout, Border.notionDatePicker, Border.dayActionsPanel, Border.dayShiftConfirmation, Border.eventMoveSheet">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellWindowRadius}" />
    </Style>
    <Style Selector="Border.suggestionCard, Border.inlineDatePicker, Border.floatingModelCard, Border.assistantActionCard, Border.dayActionGroup, Border.confirmation, Border.emptyHint, Border.metricTile, Border.chartCard, Border.insightCard, Border.agendaCard, Border.selectionBar, Border.collisionCard">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellCardRadius}" />
    </Style>
    <Style Selector="Border.count, Border.segmentHost, Border.attachmentChip, Border.modeSwitch, Border.resourceMonitorPill, Border.searchField, Border.conversationRow, Border.memoryRow, Border.factChip">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
    </Style>
    <Style Selector="Button.segment, Button.weekDay, Button.calendarDay, Button.calendarDayMini, Button.calendarDay.inline, Button.calendarDay.notion, Button.schedulerDay, Button.schedulerBlock, Button.modelSwitcher, Button.modelOptionCard, Button.modelPowerButton, Button.modeSegment, Button.modePill, Button.dayMenuTrigger, Button.dayShiftTime, Button.shiftDirection, Button.shiftApply, Button.eventMenuButton, Button.dayActionTile, Button.dayOperationsTrigger, Button.dayAction, Button.timeStep">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>
    <Style Selector="Button.modelOptionCard /template/ ContentPresenter#PART_ContentPresenter, Button.modelPowerButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
    </Style>

    <!-- Windows 10 keeps every structural surface and input deliberately square. -->
    <!-- ===================== The session, and the one question =====================
         Placed here, near the end of the file, on purpose: Avalonia ranks nothing, so a rule
         only reliably wins by being said after the bare-type rules it has to override. -->

    <!-- The plan next to the fact. Over the plan is warm, not red: overrunning is a reading. -->
    <Style Selector="TextBlock.planActual">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.planActual.over">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Where to pick the work up. Quiet, and always in the same shape wherever it appears. -->
    <Style Selector="Border.nextStepChip">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.nextStepChip icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.nextStepChip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Border.nextStepChip.row">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="260" />
    </Style>
    <Style Selector="Border.nextStepEditor">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style Selector="Border.nextStepEditor:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <!-- The gentle strip. It is a question, so it is warm rather than loud, and it arrives
         instead of appearing. -->
    <Style Selector="Border.softPrompt">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellControlRadius}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Window.motion Border.softPrompt">
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-6" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.sessionMeasured">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="TextBlock.sessionStepLabel">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== The monitoring rail =====================
         The session controls in the shape the widget already wears them: one pill, the two
         controls a session has, and the clock as the last segment of the same pill. It was a
         full-width card with a heading, a state line and the event's name in it - a lot of
         furniture for three buttons, on top of a card that already names the event. The three
         verdicts are not here: saying how something went is not a monitoring control. -->
    <Style Selector="Grid.monitorDock">
      <Setter Property="Margin" Value="14,2,14,13" />
    </Style>
    <Style Selector="Border.monitorRail">
      <Setter Property="Background" Value="{DynamicResource ShellPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="{DynamicResource MarelianShadow14}" />
      <Setter Property="RenderTransformOrigin" Value="50%,100%" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Under the hand it lifts a little, the way the pill it is modelled on does. -->
    <Style Selector="Border.monitorRail:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <!-- It rises out of the foot of the window and settles, rather than appearing there. -->
    <Style Selector="Window.motion Border.monitorRail">
      <Style.Animations>
        <Animation Duration="0:0:0.42" Easing="CubicEaseOut" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="22" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.86" />
          </KeyFrame>
          <KeyFrame Cue="62%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="-2" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.02" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- While something is actually running the edge breathes, once every two seconds and only
         there: a pill that pulsed all over would be a thing to look away from, and behind the
         assistant sheet an ambient loop re-blurs the whole surface on every frame. -->
    <Style Selector="Window.motion:not(.glass) Border.monitorRail.live">
      <Style.Animations>
        <Animation Duration="0:0:2.2" IterationCount="Infinite"
                   PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The buttons take the pointer smoothly rather than switching under it. -->
    <Style Selector="Button.railButton">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.railButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.railButton:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.88)" />
    </Style>
    <Style Selector="Button.railButton.start icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.railButton.pause icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.railButton.start:pointerover, Button.railButton.pause:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.railButton.stop icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.railButton.stop:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellDangerTransparent}" />
    </Style>
    <Style Selector="Border.railDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="3,7" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
    </Style>
    <!-- The creature is the pill's last segment rather than a thing beside it: same height,
         same radius, one hairline between it and the controls, so the whole reads as one
         control. Its seat is round rather than a capsule - there is one thing in it, and it is
         as tall as it is wide. -->
    <Style Selector="Border.railMascot">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- The day list stops above the rail when there is one, and keeps its old clearance when
         there is not. Both as rules: a margin written on the element itself is a local value,
         and no rule can take it back. -->
    <Style Selector="ScrollViewer.dayScroll">
      <Setter Property="Margin" Value="15,0,5,30" />
    </Style>
    <Style Selector="ScrollViewer.dayScroll.docked">
      <Setter Property="Margin" Value="15,0,5,2" />
    </Style>

    <!-- ===================== The clock on the day card =====================
         While a session is running the number is the loudest thing about the event, so it sits
         on the line the name is on and is read from across the room. There is no plate under
         it any more: a number this size does not need one to be found, and the plate was what
         made it read as a chip. What it has instead is the accent sliding through it while it
         counts - a light that stops the moment the session is held, because a number that keeps
         shimmering while it is not counting lies about what it is doing. -->
    <Style Selector="TextBlock.cardTimerValue">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont22}" />
      <Setter Property="LineHeight" Value="25" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <!-- Same reason as the pill's clock, and it costs more here: this number sits in an Auto
           column beside the event's name, so a digit that measured wider took the width out of
           the title and the title re-trimmed itself once a second. -->
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The colour of the digits is what moves, once every two and a half seconds and back.
         It was a band of light sliding across a panel behind them, which is a rectangle: on a
         number with gaps in it that rectangle is what the eye sees, not the digits. Nothing is
         drawn behind the clock now. Off behind the assistant sheet, where any ambient loop
         re-blurs the whole surface on every frame. -->
    <Style Selector="Window.motion:not(.glass) TextBlock.cardTimerValue.live">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="Infinite"
                   PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Foreground" Value="{DynamicResource ShellAccent}" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Foreground" Value="{DynamicResource ShellAccentGlow}" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- A held stopwatch stops looking live: a number that keeps warming and cooling while it
         is not counting lies about what it is doing. Said after the animation, which is the
         only way a rule wins in a system that ranks nothing. -->
    <Style Selector="TextBlock.cardTimerValue.held">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>

    <!-- The light that says a session is on. It belongs to the event rather than to the clock,
         so it sits on the event's own line above the number instead of being welded to it. -->
    <Style Selector="Border.cardLivePip">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource ShellMuted}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,1,3,0" />
    </Style>
    <Style Selector="Border.cardLivePip.live">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Window.motion:not(.glass) Border.cardLivePip.live">
      <Style.Animations>
        <Animation Duration="0:0:1.1" IterationCount="Infinite"
                   PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- When it was set going. A fact rather than a reading, so it is said the way the card
         says its other facts: small, muted, and with nothing drawn round it. It was a chip -
         a tinted plate with an edge and 8 px of padding - which spent more of the card on the
         container than on the four words in it, and put a box back under the very clock that
         had just given its own box up. -->
    <Style Selector="TextBlock.cardStartedNote">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9}" />
      <Setter Property="LineHeight" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,1,0" />
    </Style>

    <!-- ===================== "How did it go?", in the row's own tray =====================
         The question is asked where the event is. These are the tray's own furniture: a
         heading, three answers the width of the tray, and the second step's controls. -->
    <Style Selector="TextBlock.trayHeading">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.rowTrackAction.trayClose">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.rowTrackAction.trayClose:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- Three answers, one shape, each carrying its own colour so the choice is read rather
         than parsed. They are the same size on purpose: none of the three is the right one.
         They used to be 52-pixel tiles on a sheet in the day card; here they are a row of
         pills the width of the tray, which is the same question asked in a third of the height.
         The content is stretched rather than centred, or the lit background would shrink to
         the label while the button still filled its column. -->
    <Style Selector="Button.verdictPill">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Button.verdictPill:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.verdictPill.done icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.verdictPill.done:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.verdictPill.partial icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="Button.verdictPill.partial:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="Button.verdictPill.missed icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.verdictPill.missed:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellMuted}" />
    </Style>

    <!-- How far it got, as a figure the user lands on rather than picks from a list. The four
         preset shares were the application deciding what an honest answer looks like; the
         slider reaches every whole number and the two steps beside it land the last percent. -->
    <Style Selector="Button.progressStep">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont13}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.progressStep:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.progressValue">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.progressValue TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.progressSlider">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- One box, one button. The box wraps: it used to run the line off to the right, which
         made anything longer than a few words unreadable while it was being typed. -->
    <Style Selector="Button.stepAdd">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont15}" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stepAdd:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepRemove">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stepRemove icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.stepRemove:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellDangerTransparent}" />
    </Style>
    <Style Selector="Button.stepRemove:pointerover icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>

    <!-- The two answers to the second step, the same size, side by side across the tray. -->
    <Style Selector="Button.trayAction">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.trayAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.trayAction.save">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.trayAction.save:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHover}" />
    </Style>

    <!-- ===================== What is left =====================
         Its own card under the row, the width of the row and built like one: the same surface,
         the same accent, smaller type. It used to be an indented strip in a different colour,
         which read as something stuck to the list rather than part of it.

         There are two ways to quieten it and they answer different questions. The chevron rolls
         the lines up and leaves the heading standing with the count on it - "not now". The cross
         takes the whole card off the day and leaves one chip among the row's own chips as the
         way back - "not any more", which is what keeps a half-finished day from turning into a
         column of headings. -->
    <Style Selector="Border.leftoverCard">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- Rolled up it is a single line of heading, so it is drawn as one: the box closes around
         the heading rather than keeping the room the list was standing in. -->
    <Style Selector="Border.leftoverCard.rolled">
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <!-- The card belongs to the row above it, so it reads at the row's own strength. An event
         that is over is drawn back to 0.55 and this card was not: a note about work still to do
         sat at full contrast under a row that had gone quiet, which made the note look like the
         live half of the pair. It is the same event either way. -->
    <Style Selector="Border.leftoverCard.past">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Window.motion Border.leftoverCard">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.leftoverCard icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="TextBlock.leftoverTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Border.leftoverCount">
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.leftoverCount TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.leftoverFold">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.leftoverFold:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.leftoverFold:pointerover icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The one of the two that throws something away rather than tidying it. It answers in the
         colour that means it, and only under the hand: at rest the pair is one quiet corner. -->
    <Style Selector="Button.leftoverFold.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellDangerTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.leftoverFold.close:pointerover icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>

    <!-- Every line of it is a card of its own, small and in the shape of the row above: a
         bulleted paragraph reads as one lump of prose, and what is left is a list of separate
         things. The padding is on the text rather than on the box, because the box now has an
         edge to fill: the accent runs the full height of the line, corner to corner. -->
    <Style Selector="Border.leftoverItem">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.leftoverItem:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <!-- The event's colour, once per line rather than once per card. One rail down the side of
         the whole card bracketed the list and made the lines read as paragraphs of one note;
         repeated, the same mark says the opposite, which is what the list means. -->
    <Style Selector="Border.leftoverItemRail">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- The dot in front of the words is gone with the shared rail. A line standing in its own
         box against its own coloured edge is already marked off; a bullet on top of that is the
         third time the same thing is said. -->
    <Style Selector="TextBlock.leftoverItemText">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="9,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== The day wrap-up ===================== -->

    <Style Selector="Border.surface.wrapUpOffer">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Window.motion Border.surface.wrapUpOffer">
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Style.Animations>
        <Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The count on the drawer's own button: the one standing reminder, which is what lets
         the offer under the day card go quiet without the work going missing with it. -->
    <Style Selector="Border.headerBadge">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinWidth" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-2,-3,0" />
    </Style>
    <Style Selector="Border.headerBadge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.wrapUpRow">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ShellItemRadius}" />
      <Setter Property="Padding" Value="10,9" />
    </Style>
    <!-- An answered line stays where it was, quieter. It is a receipt, not a row any more. -->
    <Style Selector="Border.wrapUpRow.settled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Window.motion Border.wrapUpRow">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="TextBlock.wrapUpActivity">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A timer that ran is the whole of the application's evidence, so it is the one part of
         the line that is coloured: the reader can see why "done" is being proposed. -->
    <Style Selector="TextBlock.wrapUpActivity.worked">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.wrapUpAction">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.wrapUpAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.wrapUpAction:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <!-- The proposed answer is lit. Confirming a reading should be the obvious tap; the other
         two are still one tap away, which is the difference between a suggestion and a default. -->
    <Style Selector="Button.wrapUpAction.suggested">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.wrapUpAction.suggested:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
    </Style>

    <Style Selector="Button.blockerChoice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.blockerChoice:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>

    <!-- ===================== The widget's two strips ===================== -->

    <Style Selector="Button.peekRailButton.pause icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.peekRailButton.stop icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellDanger}" />
    </Style>
    <Style Selector="Button.peekRailButton.pause:pointerover, Button.peekRailButton.stop:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <!-- The widget's two questions, each in a block of its own under the clock. Their edges
         used to be tinted with the accent to say that they ask rather than report, which left
         them the only blocks on the card wearing a different border from the blocks stacked
         directly above and below them - at this size that reads as one card being wrong rather
         than as one card being emphasised. What says they are questions is the question printed
         across the top of them, and the answers underneath. -->
    <Style Selector="Border.peekBlock.promptBlock, Border.peekBlock.pausePromptBlock">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
    </Style>
    <!-- Both questions arrive out of the block above them, the way every other block in the
         widget arrives. They were the two that simply appeared: stopping a session put a whole
         card on the screen in one frame, in the middle of a widget whose every other part
         settles. The blocks carry RenderTransformOrigin 50%,0% from peekBlock, so growing is
         downwards - out from under the card the question is about.

         Played off a class bound to the same answer as the visibility, not off the block itself:
         a style animation runs when its selector starts matching, and a selector that matches a
         block sitting hidden in the tree has already run by the time the block is shown. -->
    <Style Selector="Window.motion Border.peekBlock.promptBlock.on, Window.motion Border.peekBlock.pausePromptBlock.on">
      <Style.Animations>
        <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-10" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.peekPromptTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.peekPromptButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.peekPromptButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.peekPromptButton.done icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.peekPromptButton.partial icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="Button.peekPromptButton.missed icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Button.peekPromptButton.keep">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.peekPromptButton.keep TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>

    <!-- Reduced motion accessibility mode -->
    <Style Selector="Window.reduceMotion Button /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Window.reduceMotion Border.interactive">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Window.reduceMotion local|ChatFlyoutView.chatFlyout">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Window.reduceMotion icons|AnimatedIcon.expandChevron">
      <Setter Property="Transitions"><Transitions /></Setter>
    </Style>
    <Style Selector="Window.reduceMotion icons|AnimatedIcon">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Window.reduceMotion ScrollBar, Window.reduceMotion Thumb.capsuleScrollThumb, Window.reduceMotion Border.capsuleScrollRail">
      <Setter Property="Transitions"><Transitions /></Setter>
    </Style>
    <Style Selector="Window.reduceMotion Border.timeWheelColumn">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Window.reduceMotion Border.suggestionCard">
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <!-- The report's charts. Every bar carries its value through a length, and a length that
         is animated is a length that travels — so with the reveal switched off the bars were
         still sliding to their answer, one report's numbers visibly becoming the next one's.
         "Reduced motion" here means the chart is simply drawn at the figure it is reporting:
         the view model already builds them standing (see the reveal flag in Apply), and this is
         the other half of that, which the transitions on the bars were quietly undoing.

         Last in the file on purpose: Avalonia matches styles in order with no notion of
         specificity, so a rule that takes a transition off has to be said after the one that
         put it on. -->
    <Style Selector="Window.reduceMotion Border.chartBar, Window.reduceMotion Border.hourBar,
                     Window.reduceMotion Border.weekdayBar, Window.reduceMotion Path.donutSlice">
      <Setter Property="Transitions"><Transitions /></Setter>
    </Style>
    <!-- The session sheet, the pause strip and the wrap-up offer all arrive by moving. With
         motion off they are simply there, which is what "arrive" has to mean instead. -->
    <Style Selector="Window.reduceMotion Border.wrapUpRow">
      <Setter Property="Transitions"><Transitions /></Setter>
    </Style>

    <!-- ===================== The grip on every slider =====================
         The same object the scroll bars use, laid the way this one runs. It was an upright oval
         - a capsule stood on its end on a rail that lies flat, which is the one orientation a
         scroll grip never has. It is a flat horizontal capsule now: faint at rest, thickening
         and lighting up under the pointer, pressed a touch further, exactly the three states
         the scroll grip wears.

         It only ever grows across the track, never along it. The track's arithmetic is done
         against the grip's own length, so a grip that lengthened under the pointer would slide
         out from under the finger that was reaching for it. Said here, at the end, because it
         has to win against the theme's own thumb. -->
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentGlow}" />
      <Setter Property="BorderThickness" Value="0.6" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1,1)" />
      <!-- Drawn rather than resized. The theme's template writes the thumb's width and height
           straight onto the element, and a value written there beats every rule in this file -
           which is why the grip was a squashed circle before and not a capsule. So the shape is
           what this template draws: a flat capsule, laid out inside a box the size the track
           measured, which stays transparent and keeps a finger's worth of surface to catch. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Border Width="20" Height="6" CornerRadius="999"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BoxShadow="{DynamicResource MarelianShadow1}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Slider /template/ Thumb:pointerover">
      <Setter Property="Opacity" Value="0.92" />
      <Setter Property="RenderTransform" Value="scale(1,1.34)" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Slider /template/ Thumb:pressed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1,1.5)" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentDeep}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentGlow}" />
    </Style>
    <!-- Only the travel between the states goes, not the states. The scroll grip is treated the
         same way: with motion off it still thickens under the pointer, it just arrives there. -->
    <Style Selector="Window.reduceMotion Slider /template/ Thumb">
      <Setter Property="Transitions"><Transitions /></Setter>
    </Style>

    <!-- ===================== Projects =====================
         A project is not a list of its own: it is a task or an event broken into steps, and it is
         drawn as the row it already was. A task that has been broken up keeps its rail, its tick
         and its tags; under its name comes a thin bar of how far along it is, and a chip that
         says how many of its steps are done and opens them. An event that has been broken up keeps
         its row the same way and carries its checklist in a card of its own under it, built like
         the "what is left" note it sits beside. A step is a small row inside either: a round
         tick, the name, and the chips for what the user decides about it. -->
    <Style Selector="Border.projectProgressTrack">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource ShellStroke}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ProgressBar.projectProgress">
      <Setter Property="Height" Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Border.projectGlyph">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A day inside a card. Today is said in the accent and a day that is over with work still
         on it in the warning colour - the two colours the rest of the shell already uses for
         "now" and for "waiting". -->
    <Style Selector="TextBlock.stepDayTitle">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.3" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.stepDayTitle.today">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="TextBlock.stepDayTitle.overdue">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="TextBlock.stepDayTotal">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.rowTag.lateChip">
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Background" Value="#2EF4B860" />
    </Style>
    <Style Selector="Border.rowTag.lateChip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="TextBlock.dayStepsHeading">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.stepRow">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.stepRow:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.stepRow.done">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.stepRowRail">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="StackPanel.stepActions">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.stepRow:pointerover StackPanel.stepActions">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- The tick is a ring until it is pressed, and a filled green dot after: the same two
         colours "done" wears everywhere else in the shell. -->
    <Style Selector="Button.stepCheck">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="9,0,8,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellMuted}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stepCheck icons|AnimatedIcon">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepCheck:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepCheck:pointerover icons|AnimatedIcon">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.stepCheck.done">
      <Setter Property="Background" Value="{DynamicResource ShellSuccess}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.stepCheck.done:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellSuccess}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.stepCheck.done icons|AnimatedIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
    </Style>

    <Style Selector="TextBlock.stepTitleText">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont12}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.stepTitleText.done">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <!-- The name is a button only to be pressed: no plate, no padding, no press shrink. It says
         it can be edited with the text cursor and by warming to the accent under the pointer. -->
    <Style Selector="Button.stepTitle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Ibeam" />
    </Style>
    <Style Selector="Button.stepTitle:pointerover /template/ ContentPresenter, Button.stepTitle:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.stepTitle:pointerover TextBlock.stepTitleText">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccentHover}" />
    </Style>
    <Style Selector="TextBox.stepRenameInput">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont12}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- A chip that is also a button: the tag's box, answering the pointer the way a field does. -->
    <Style Selector="Button.stepChip">
      <Setter Property="Height" Value="19" />
      <Setter Property="MinHeight" Value="19" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.stepChip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Button.stepChip icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stepChip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepChip:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
    </Style>
    <Style Selector="Button.stepChip:pointerover icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <!-- The one chip that invites: a step that has no hour yet. Once it has one, the chip is the
         hour itself, filled, and pressing it goes to the event. -->
    <Style Selector="Button.stepChip.time">
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.stepChip.time TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepChip.time icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepChip.time.booked">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.stepChip.time.booked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.stepComposer">
      <Setter Property="Padding" Value="9,4,5,4" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- A task opened onto its project: the card stays lit while it is open, the way the event
         composer's card does, so the days inside it read as part of the task and not as a list
         that happens to follow it. -->
    <Style Selector="Border.agendaCard.taskRow.expanded">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
    </Style>
    <!-- "next: …" under a project's tags, in the voice of the event's hours: small and muted. -->
    <Style Selector="TextBlock.projectNext">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The chip that says how far through its steps a row is, and opens them. It is a tag like
         the ones beside it - the same height, corner and type - that happens to answer the
         pointer. Its colour is the one the rest of the shell uses for "yours to open", and it
         turns to the colour of "done" once every step is. -->
    <Style Selector="Button.stepsChip">
      <Setter Property="Height" Value="19" />
      <Setter Property="MinHeight" Value="19" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.stepsChip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont9_5}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stepsChip icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stepsChip:pointerover, Button.stepsChip.open">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Button.stepsChip:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.stepsChip:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.stepsChip.complete">
      <Setter Property="Background" Value="{DynamicResource ShellSuccessSoft}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.stepsChip.complete:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.stepsChip.complete TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>
    <Style Selector="Button.stepsChip.complete icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellSuccess}" />
    </Style>

    <!-- A tag that opens something: the project's name on a step or a slot. The button draws
         nothing of its own - the tag inside it is the whole of what is seen - and under the hand
         the tag takes an edge in its own colour. -->
    <Style Selector="Button.chipLink">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chipLink:pointerover, Button.chipLink:pressed">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chipLink:pressed /template/ ContentPresenter">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.chipLink:pointerover Border.rowTag">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <!-- An event's checklist: its own card under the row, like the "what is left" note it sits
         among. An event that is over draws it back less than the row, because this card is where
         what is left gets carried on from, and buttons at half strength read as switched off. -->
    <Style Selector="Border.sittingCard">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Padding" Value="9,7,9,8" />
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sittingCard.past">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.sittingCard.past:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.sittingCard icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.sittingCard Button.stepAdd">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <!-- How the steps sit in the event's time. It turns to the colour of waiting when they ask
         for more than the event has: said, not refused - an hour can be planned tight. -->
    <Style Selector="TextBlock.sittingSummary">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sittingSummary.overflow">
      <Setter Property="Foreground" Value="{DynamicResource ShellWarning}" />
    </Style>
    <Style Selector="TextBlock.hint.sittingHint">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Margin" Value="1,0,1,1" />
    </Style>
    <Style Selector="TextBlock.sittingCarryText">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- One line of the checklist, in the shape of a "what is left" line: its own small card with
         the event's colour down its left edge. Done lines step back rather than vanish - the list
         is also the record of what the hour was spent on. -->
    <Style Selector="Border.sittingStep">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sittingStep:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentSoft}" />
    </Style>
    <Style Selector="Border.sittingStep.done">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.sittingStep Button.stepDelete">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sittingStep:pointerover Button.stepDelete">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.stepCheck.small">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="MinHeight" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1.4" />
      <Setter Property="Margin" Value="8,0,7,0" />
    </Style>
    <Style Selector="TextBlock.stepTitleText.sitting">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
    </Style>
    <Style Selector="TextBox.stepRenameInput.sitting">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11}" />
    </Style>

    <!-- The way into a list, in a form: one quiet line in the accent rather than a section laid
         out in advance. Most events are one thing, and a form that always shows a list reads as
         a form that expects one. -->
    <Style Selector="Button.draftToggle">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ShellAccentTransparent}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.draftToggle TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont11_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.draftToggle icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.draftToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
    </Style>

    <!-- Carrying on what a sitting left undone: two answers side by side, the second - another
         hour - the one most often meant, so it wears the accent. -->
    <Style Selector="Button.carryAction">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.carryAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
    </Style>
    <Style Selector="Button.carryAction.primary">
      <Setter Property="Background" Value="{DynamicResource ShellAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellOnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.carryAction.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHover}" />
    </Style>

    <!-- "How did it go?" on an event with steps: a line that points at the checklist, which is
         the list of what is left, instead of a second list written by hand. -->
    <Style Selector="Border.sittingReviewHint">
      <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style Selector="Border.sittingReviewHint TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource MarelianFont10_5}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}" />
    </Style>
    <Style Selector="Border.sittingReviewHint icons|AnimatedIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellAccent}" />
    </Style>
  </Application.Styles>
</Application>
